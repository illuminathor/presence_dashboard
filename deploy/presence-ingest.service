# /etc/systemd/system/presence-ingest.service
[Unit]
Description=Presence ingest (MQTT -> Supabase)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=presence
WorkingDirectory=/opt/presence/ingest
EnvironmentFile=/opt/presence/ingest/.env
# heap Node dibatasi ~96 MB; systemd membatasi total 200 MB agar server 1 GB tetap aman
ExecStart=/usr/bin/node --max-old-space-size=96 dist/index.js
Restart=always
RestartSec=3
MemoryMax=200M
CPUQuota=50%
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/opt/presence/ingest/data

[Install]
WantedBy=multi-user.target

# systemd USER service: ~/.config/systemd/user/presence-ingest.service
# Tidak butuh sudo untuk start/stop/restart. Butuh sekali: sudo loginctl enable-linger $USER
[Unit]
Description=Presence ingest (MQTT -> Supabase)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/presence_dashboard/ingest
EnvironmentFile=%h/presence_dashboard/ingest/.env
# heap Node dibatasi ~96 MB; total proses dibatasi 200 MB agar server 1 GB tetap aman
ExecStart=/usr/bin/env node --max-old-space-size=96 dist/index.js
Restart=always
RestartSec=3
MemoryMax=200M
NoNewPrivileges=true

[Install]
WantedBy=default.target

{
  "name": "presence-server",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env src/index.ts",
    "build": "tsc",
    "start": "node --max-old-space-size=128 --disable-warning=ExperimentalWarning dist/index.js",
    "user": "node --disable-warning=ExperimentalWarning dist/cli.js",
    "test": "tsx --test src/*.test.ts"
  },
  "dependencies": { "mqtt": "^5.10.0" },
  "devDependencies": { "@types/node": "^22.13.0", "tsx": "^4.19.0", "typescript": "^5.6.0" }
}
